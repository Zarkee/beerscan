rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidUser() {
      return isSignedIn() && 
             request.resource.data.keys().hasAll(['nickname', 'email']) &&
             request.resource.data.nickname is string &&
             request.resource.data.email is string;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles (for social features)
      allow read: if isSignedIn();
      
      // Only owner can create/update their profile
      allow create: if isOwner(userId) && isValidUser();
      allow update: if isOwner(userId);
      
      // Only owner can delete their profile
      allow delete: if isOwner(userId);
    }
    
    // User history (private) - struktura: /userHistory/{userId}/beers/{barcode}
    match /userHistory/{userId} {
      // Anyone signed in can read (for viewing other users' profiles)
      allow read: if isSignedIn();
      // Only owner can write
      allow write: if isOwner(userId);
      
      // Beers subcollection
      match /beers/{barcode} {
        // Anyone signed in can read beer history (for social features)
        allow read: if isSignedIn();
        // Only owner can write their beer history
        allow write: if isOwner(userId);
      }
    }
    
    // Legacy support - stara struktura /userHistory/{userId}/items/{itemId}
    match /userHistory/{userId}/items/{itemId} {
      // Anyone signed in can read (for social features)
      allow read: if isSignedIn();
      // Only owner can write
      allow write: if isOwner(userId);
    }
    
    // Active users (for online status)
    match /activeUsers/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }
    
    // Chat messages
    match /chatMessages/{messageId} {
      // Anyone can read messages
      allow read: if isSignedIn();
      
      // Only authenticated users can create messages
      // Podrška za oba formata: userId/createdAt i uid/timestamp
      allow create: if isSignedIn() && 
                       (request.resource.data.userId == request.auth.uid || 
                        request.resource.data.uid == request.auth.uid) &&
                       request.resource.data.keys().hasAll(['text', 'nickname']);
      
      // Only message owner can update/delete
      allow update, delete: if isSignedIn() && 
                               (resource.data.userId == request.auth.uid ||
                                resource.data.uid == request.auth.uid);
    }
    
    // Stories
    match /stories/{storyId} {
      // Anyone can read stories
      allow read: if isSignedIn();
      
      // Only authenticated users can create stories
      allow create: if isSignedIn() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['userId', 'userNickname', 'imageUrl', 'createdAt', 'expiresAt']);
      
      // Only story owner can update (for reactions)
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Only story owner can delete
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Follows collection
    match /follows/{userId} {
      // Anyone can read follows
      allow read: if isSignedIn();
      
      // Followers subcollection
      match /followers/{followerId} {
        // Anyone can read followers
        allow read: if isSignedIn();
        
        // Only the follower can create/delete their follow
        allow create, delete: if isSignedIn() && followerId == request.auth.uid;
      }
      
      // Following subcollection
      match /following/{followingId} {
        // Anyone can read following
        allow read: if isSignedIn();
        
        // Only the user can create/delete their following
        allow create, delete: if isOwner(userId);
      }
    }
    
    // Notifications
    match /notifications/{userId} {
      // Only owner can read their notifications
      allow read: if isOwner(userId);
      
      // Notification items subcollection
      match /items/{notificationId} {
        // Only owner can read their notifications
        allow read: if isOwner(userId);
        
        // Anyone can create notifications for other users
        allow create: if isSignedIn();
        
        // Only owner can update (mark as read) or delete
        allow update, delete: if isOwner(userId);
      }
    }
    
    // Cheers collection
    match /cheers/{cheersId} {
      // Anyone can read cheers
      allow read: if isSignedIn();
      
      // Only authenticated users can create cheers
      allow create: if isSignedIn() && 
                       request.resource.data.fromUserId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['fromUserId', 'fromNickname', 'toUserId', 'createdAt']);
      
      // Only sender can delete
      allow delete: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
    }
    
    // Reactions (if separate collection)
    match /reactions/{reactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // User settings (private)
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Badges (read-only for users)
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow write: if false; // Only admin can write
    }
    
    // User badges
    match /userBadges/{userId}/badges/{badgeId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }
    
    // Leaderboard (read-only)
    match /leaderboard/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }
    
    // Reports (for moderation)
    match /reports/{reportId} {
      allow read: if false; // Only admin
      allow create: if isSignedIn();
    }
    
    // Block list
    match /blocks/{userId}/blocked/{blockedUserId} {
      allow read, write: if isOwner(userId);
    }
    
    // Feed collection - aktivnosti korisnika
    match /feed/{userId} {
      // Anyone can read feed (for following)
      allow read: if isSignedIn();
      
      // Feed items subcollection
      match /items/{itemId} {
        // Anyone can read feed items
        allow read: if isSignedIn();
        
        // Only owner can create/update/delete their feed items
        allow create, update, delete: if isOwner(userId);
      }
    }
  }
}
