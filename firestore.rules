rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User history - svi mogu čitati, samo vlasnik može pisati
    match /userHistory/{userId} {
      // Dozvoli čitanje parent dokumenta svim prijavljenim korisnicima
      allow read: if request.auth != null;
      
      // Beers subcollection
      match /beers/{barcode} {
        // Svi prijavljeni mogu čitati istoriju (za profile view)
        allow read: if request.auth != null;
        // Samo vlasnik može pisati/menjati svoju istoriju
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Chat messages - svi prijavljeni mogu čitati i pisati
    match /chatMessages/{messageId} {
      // Svi prijavljeni mogu čitati poruke
      allow read: if request.auth != null;
      
      // Samo prijavljeni mogu kreirati poruke sa svojim UID-om
      allow create: if request.auth != null && 
                      request.resource.data.uid == request.auth.uid &&
                      request.resource.data.timestamp != null &&
                      // Dozvoli opciono beerData polje
                      (!request.resource.data.keys().hasAny(['beerData']) || 
                       request.resource.data.beerData is map);
      
      // Poruke mogu biti obrisane od strane:
      // 1. Vlasnika poruke
      // 2. Automatski nakon 24h (server-side cleanup)
      allow delete: if request.auth != null && 
                      (resource.data.uid == request.auth.uid || 
                       request.time > resource.data.timestamp + duration.value(1, 'd'));
      
      // Poruke ne mogu biti izmenjene
      allow update: if false;
    }
    
    // Users collection - korisnici mogu čitati sve profile, ali menjati samo svoj
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Active users - za tracking online korisnika
    match /activeUsers/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Automatsko brisanje neaktivnih korisnika (5 minuta)
      allow delete: if request.auth != null;
    }
    
    // Follows - follow/unfollow sistem
    match /follows/{userId}/following/{followedId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /follows/{userId}/followers/{followerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Feed - aktivnosti korisnika
    match /feed/{userId}/items/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Reactions - lajkovi na piva
    match /reactions/{beerId}/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Notifications - notifikacije za korisnika
    match /notifications/{userId}/items/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Dozvoli kreiranje notifikacija od bilo kog prijavljenog korisnika
      allow create: if request.auth != null &&
                      request.resource.data.type != null &&
                      request.resource.data.data != null &&
                      request.resource.data.createdAt != null;
      // Dozvoli ažuriranje samo vlasniku (za read status)
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Stories - 24h stories
    match /stories/{storyId} {
      // Svi prijavljeni mogu čitati stories
      allow read: if request.auth != null;
      
      // Samo vlasnik može kreirati svoj story
      allow create: if request.auth != null && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.createdAt != null &&
                      request.resource.data.expiresAt != null;
      
      // Dozvoli update za viewsCount i reactionsCount
      allow update: if request.auth != null && (
        // Samo ažuriranje brojača
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'reactionsCount'])
      );
      
      // Samo vlasnik može obrisati svoj story
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Story views - ko je pogledao story
      match /views/{viewerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == viewerId;
        allow update: if request.auth != null && request.auth.uid == viewerId;
        allow delete: if request.auth != null && request.auth.uid == viewerId;
      }
      
      // Story reactions - reakcije na story
      match /reactions/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
